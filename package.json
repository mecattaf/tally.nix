{
  "name": "tally",
  "version": "0.1.0",
  "private": true,
  "description": "tally — agent-session orchestration: one Bun-compiled binary (daemon + CLI)",
  "type": "module",
  "license": "SEE docs/REFERENCES.md",
  "engines": {
    "bun": ">=1.3.0"
  },
  "bin": {
    "tally": "dist/tally"
  },
  "scripts": {
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "build": "bun build --compile --outfile=dist/tally src/main.ts",
    "bun2nix": "nix run .#bun2nix"
  },
  "dependencies": {
    "smol-toml": "1.3.1"
  },
  "devDependencies": {
    "@types/bun": "1.1.14",
    "bun-types": "1.1.34",
    "typescript": "5.7.3"
  }
}
