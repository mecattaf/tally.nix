{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tally.nix/schemas/flow-catalog-v1.json",
  "title": "tally flow selector catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "members"],
  "properties": {
    "version": { "const": 1 },
    "members": {
      "type": "array",
      "items": { "$ref": "#/$defs/member" }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "family",
        "maker",
        "classes",
        "adapter",
        "pools",
        "launch"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "family": { "$ref": "#/$defs/nonEmptyString" },
        "maker": { "$ref": "#/$defs/nonEmptyString" },
        "classes": { "$ref": "#/$defs/stringList" },
        "adapter": { "$ref": "#/$defs/nonEmptyString" },
        "pools": { "$ref": "#/$defs/stringList" },
        "launch": {
          "type": "object",
          "minProperties": 1,
          "required": ["model"],
          "properties": {
            "prePromptArgv": {
              "type": "array",
              "items": { "type": "string" }
            },
            "environment": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "approvalPolicy": { "$ref": "#/$defs/nonEmptyString" },
            "sandboxPolicy": { "$ref": "#/$defs/nonEmptyString" },
            "model": { "$ref": "#/$defs/nonEmptyString" },
            "effort": { "$ref": "#/$defs/nonEmptyString" }
          },
          "additionalProperties": false
        },
        "architecture": { "$ref": "#/$defs/nonEmptyString" },
        "fineTune": { "$ref": "#/$defs/nonEmptyString" },
        "backend": { "$ref": "#/$defs/nonEmptyString" },
        "modality": { "$ref": "#/$defs/nonEmptyString" },
        "role": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "$ref": "#/$defs/nonEmptyString" },
        "evidence": { "$ref": "#/$defs/nonEmptyString" },
        "hosts": { "$ref": "#/$defs/stringList" },
        "baseCheckpoint": { "$ref": "#/$defs/nonEmptyString" },
        "supersedes": { "$ref": "#/$defs/nonEmptyString" },
        "supersededBy": { "$ref": "#/$defs/nonEmptyString" },
        "notes": { "type": "string" }
      }
    }
  }
}
