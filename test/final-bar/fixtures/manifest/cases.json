    ]},
    {"name": "reject-forbid-trailing-slash", "expect": "reject", "ops": [
      {"op": "set", "path": ["campaign", "gates", 0], "value": {"kind": "forbidPaths", "id": "paths", "forbidPaths": ["build/"], "runtimeMaxSec": 30}}
    ]},
    {"name": "reject-zero-steward-runtime", "expect": "reject", "ops": [
