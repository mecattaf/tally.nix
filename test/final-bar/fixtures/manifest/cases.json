      {"op": "set", "path": ["campaign", "agent", "typo"], "value": true}
    ]},
    {"name": "reject-steward-shape", "expect": "reject", "ops": [
      {"op": "set", "path": ["campaign", "steward"], "value": {"adapter": "narrator"}}
    ]},
    {"name": "reject-steward-argv", "expect": "reject", "ops": [
      {"op": "set", "path": ["campaign", "steward"], "value": "narrator"},
      {"op": "set", "path": ["campaign", "stewardArgv"], "value": [""]}
    ]},
    {"name": "reject-command-gate-unknown", "expect": "reject", "ops": [
      {"op": "set", "path": ["campaign", "gates", 0, "typo"], "value": true}
    ]},
    {"name": "reject-forbid-gate-unknown", "expect": "reject", "ops": [
      {"op": "set", "path": ["campaign", "gates", 0], "value": {"kind": "forbidPaths", "id": "paths", "forbidPaths": ["*.tmp"], "runtimeMaxSec": 30, "typo": true}}
    ]},
    {"name": "reject-task-unknown", "expect": "reject", "ops": [
      {"op": "set", "path": ["tasks", 0, "typo"], "value": true}
    ]},
    {"name": "reject-gate-enum", "expect": "reject", "ops": [
      {"op": "set", "path": ["campaign", "gates", 0, "kind"], "value": "futureGate"}
    ]},
    {"name": "reject-task-enum", "expect": "reject", "ops": [
      {"op": "set", "path": ["tasks", 0, "kind"], "value": "futureTask"}
    ]},
    {"name": "reject-merge-enum", "expect": "reject", "ops": [
      {"op": "set", "path": ["campaign", "mergeMethod"], "value": "rebase"}
    ]},
    {"name": "reject-priority-enum", "expect": "reject", "ops": [
      {"op": "set", "path": ["campaign", "agent", "priority"], "value": "background"}
    ]},
    {"name": "reject-parallel-domains-omitted", "expect": "reject", "ops": [
