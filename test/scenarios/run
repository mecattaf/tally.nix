#!/usr/bin/env bash

set -euo pipefail

scenario_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
scenario="${1:-}"

case "$scenario" in
  fleet-conformance)
    exec "${BASH:-bash}" "$scenario_dir/fleet-conformance.sh"
    ;;
  fanout-guardrail)
    exec "${BASH:-bash}" "$scenario_dir/fanout-guardrail.sh"
    ;;
  pool-vanished/return)
    exec "${BASH:-bash}" "$scenario_dir/pool-vanished-return.sh"
    ;;
  *)
    printf 'usage: %s {fleet-conformance|fanout-guardrail|pool-vanished/return}\n' "$0" >&2
    exit 2
    ;;
esac
